<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="camera"
        android:enabled="true"
        android:icon="@drawable/ic_lucide_camera"
        android:shortcutShortLabel="@string/shortcut_take_picture"
        android:shortcutLongLabel="@string/shortcut_take_picture">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="me.yui.yuihub.ui.activity.ShortcutHandlerActivity"
            android:data="yuihub://shortcut" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="image_generation"
        android:enabled="true"
        android:icon="@drawable/ic_image_generation"
        android:shortcutShortLabel="@string/shortcut_image_generation"
        android:shortcutLongLabel="@string/shortcut_image_generation">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="me.yui.yuihub.RouteActivity"
            android:data="yuihub://image-generation" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
